<?xml version="1.0" encoding="utf-8"?>
<!-- 차량용(Pleos) 설정: 권한 선언, 본 화면, 시험 화면 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos SDK 권한 (개발 중에는 선언만 하면 쓸 수 있다) -->
    <!-- 내 차 위치. 'dangerous' 등급이라 앱 실행 중에 허락을 받아야 한다 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 브레이크 페달 상태 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 방향지시등 읽기, 앰비언트 라이트 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 앰비언트 라이트 바꾸기. SDK 설명서에는 CAR_LIGHTS라고 적혀 있지만 실제 SDK 코드는 이 권한을 요구한다 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- Pleos 음성 안내(TTS) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 안드로이드 차량 표준 권한 -->
    <!-- 차량 속도 (계기판과 같은 값). 'dangerous' 등급 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 기어 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- 안드로이드 기본 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 다른 앱(내비) 위에 화면을 덮어 그리기 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 앱 화면 없이 뒤에서 계속 돌기 (알림창에 '길터줘 수신 중' 표시) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 차를 켜면 자동으로 시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- 안드로이드 차량 표준 기능 라이브러리 -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- 길터줘 본 화면 (수신 대기). 앱 목록에 "길터줘"로 보인다 -->
        <activity
            android:name=".screen.WaitingActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- 수신 서비스: 앱 화면을 열지 않아도 뒤에서 위치·긴급차량을 받아 계산하고 알린다 -->
        <service
            android:name=".service.ReceiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="긴급차량 접근 알림: 내비를 쓰는 중에도 주변 긴급차량을 받아 화면·소리로 알린다" />
        </service>

        <!-- 차가 켜지거나 새 판이 설치되면 수신 서비스를 자동으로 시작 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- SDK 시험 화면. 앱 목록에 "길터줘 시험"으로 따로 보인다 -->
        <activity
            android:name=".sdktest.SdkTestActivity"
            android:exported="true"
            android:label="@string/test_app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "이 화면은 주행 중에 봐도 되게 만들었다"는 선언. 실제로 인정되는지 시험한다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
